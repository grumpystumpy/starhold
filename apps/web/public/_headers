# Workers static assets default to max-age=0. Override only the long-lived
# files. One wildcard or placeholder per rule. Do not set Cache-Control
# twice for the same path: matching rules are joined with a comma.
# HTML and extensionless routes keep the default so a deploy is picked up.
# Hashed Vite chunks (assets/index-<hash>.js). README.md stays default.
/assets/:name.js
  Cache-Control: public, max-age=31536000, immutable
/assets/:name.css
  Cache-Control: public, max-age=31536000, immutable
# Unhashed plates (buildings, ships, icons): assets/<dir>/<file>.
/assets/:dir/:file
  Cache-Control: public, max-age=2592000
# Planet art, including thumbs (planet-art/<pool>/thumbs/<file>).
/planet-art/:file
  Cache-Control: public, max-age=2592000
/planet-art/:pool/:file
  Cache-Control: public, max-age=2592000
/planet-art/:pool/:kind/:file
  Cache-Control: public, max-age=2592000

# The shell worker and manifest must revalidate or a deploy can pair old HTML
# with a new worker. Icons are unhashed, so they share the plate lifetime.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: text/javascript; charset=utf-8
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json
/icons/:file
  Cache-Control: public, max-age=2592000
  Content-Type: image/png
