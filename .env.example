# Vercel: Project starhold → Settings → Environment Variables
# (Production + Preview). Then Redeploy.

# --- Required for shared multiplayer on Vercel ---
# Upstash console → your DB → REST API
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_REST_TOKEN

# --- Optional ---
STARHOLD_UNIVERSE_KEY=starhold:universe:v1
STARHOLD_UNIVERSE_NAME=Alpha Drift
STARHOLD_UNIVERSE_SPEED=8
ALLOWED_ORIGINS=https://starhold-two.vercel.app

# Local Node only (ignored on Vercel)
# PORT=3001
