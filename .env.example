# Copy to .env.local for local experiments (optional).
# On Vercel: Project → Settings → Environment Variables (Production + Preview).

# --- Required on Vercel for shared multiplayer state (Upstash free Redis) ---
# From https://console.upstash.com/ → your database → REST API
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_REST_TOKEN

# --- Optional ---
# Redis key for the universe JSON document
STARHOLD_UNIVERSE_KEY=starhold:universe:v1

# Seed name / economy speed when the key is empty (first boot)
STARHOLD_UNIVERSE_NAME=Alpha Drift
STARHOLD_UNIVERSE_SPEED=8

# Extra CORS origins (comma-separated). Same-origin Vercel UI usually needs none.
# Local Vite already allowed: http://localhost:5173
ALLOWED_ORIGINS=https://your-app.vercel.app

# Local Node server port (ignored on Vercel)
# PORT=3001
