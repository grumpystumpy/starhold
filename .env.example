# Vercel Upstash / KV integration (preferred — already on starhold project):
KV_REST_API_URL=https://YOUR-DB.upstash.io
KV_REST_API_TOKEN=YOUR_REST_TOKEN
# KV_REST_API_READ_ONLY_TOKEN=...  # ignore for writes
# KV_URL=...
# REDIS_URL=...

# Or classic Upstash REST names (also accepted):
# UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
# UPSTASH_REDIS_REST_TOKEN=YOUR_REST_TOKEN

# Accounts / email+password (see docs/vercel-deploy.md)
# Required on Vercel production (signup/login refuse without it):
SESSION_SECRET=generate-a-long-random-string
# APP_URL=https://starhold-two.vercel.app

# Optional
STARHOLD_UNIVERSE_KEY=starhold:universe:v3
STARHOLD_UNIVERSE_NAME=Alpha Drift
STARHOLD_UNIVERSE_SPEED=8
ALLOWED_ORIGINS=https://starhold-two.vercel.app

# Local Node only
# PORT=3001

# Workers host (not used by Vercel until cut-over). Set SESSION_SECRET with
# `wrangler secret put`, not in this file. See docs/cloudflare.md.
# STARHOLD_RUNTIME=workers
# STARHOLD_PASSWORD_KDF=pbkdf2
